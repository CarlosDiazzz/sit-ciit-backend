{
  "name": "sit-ciit-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx scripts/migrate.ts",
    "create-user": "tsx scripts/create-user.ts",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "fastify": "^5.1.0",
    "@fastify/cors": "^10.0.1",
    "mqtt": "^5.10.1",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8",
    "uuid": "^11.0.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.2",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/jsonwebtoken": "^9.0.7"
  }
}
