# Copiar a .env y ajustar. No commitear .env real.

PORT=3000

# --- Postgres / TimescaleDB (mismos valores que sit-ciit-infra/.env;
# puerto 5433 por defecto, ver POSTGRES_HOST_PORT en sit-ciit-infra) ---
DATABASE_URL=postgres://sitciit:changeme@localhost:5433/sitciit

# --- MQTT (usuario creado con sit-ciit-infra/scripts/create-mqtt-user.sh) ---
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=sitciit-dev
MQTT_PASSWORD=changeme

# --- Auth ---
JWT_SECRET=changeme-usar-algo-largo-y-aleatorio

# --- Alertas (opcional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Datos externos ---
OPENCELLID_API_KEY=

# --- Avisos por correo (Resend) ---
# Sin RESEND_API_KEY el backend usa el adaptador de consola: los avisos
# se registran en el log en vez de enviarse. Levantar sin credenciales
# no rompe el inicio de sesion.
#
# La clave se saca de resend.com/api-keys y NO se commitea: va en .env,
# que esta en .gitignore.
RESEND_API_KEY=
# onboarding@resend.dev funciona sin verificar dominio, que es lo que
# hace falta para probar en local. En produccion, un dominio propio.
RESEND_FROM=SIT-CIIT <onboarding@resend.dev>
